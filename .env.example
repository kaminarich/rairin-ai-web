# RaiRin-AI licence stats
#
# Copy to .env.local for local runs, or set the same keys in Vercel
# (Settings -> Environment Variables). Never commit real values.
#
# Count of licensed device serials shown in the hero. Mirrors the deduplicated
# licence total reported by Rairin Manager.
RAIRIN_ACTIVE_DEVICES=
# Date shown beside the figure, e.g. 2026-09-06
RAIRIN_STATS_UPDATED_AT=
# Optional: JSON endpoint returning { "unique": <int> } or { "activeDevices": <int> }.
# Takes precedence over RAIRIN_ACTIVE_DEVICES and is re-read every 15 minutes.
RAIRIN_STATS_URL=
# Optional bearer token for that endpoint.
RAIRIN_STATS_TOKEN=
