# RaiRin-AI licence stats
#
# Copy to .env.local for local runs, or set the same keys in Vercel
# (Settings -> Environment Variables). Never commit real values.

# --- live figure, preferred --------------------------------------------------
# JSON endpoint returning { "active": <int> } (or { "unique": <int> }).
# Re-read every 5 minutes, so the hero tracks the server without a redeploy.
RAIRIN_STATS_URL=
# Bearer token for that endpoint, if it requires one.
RAIRIN_STATS_TOKEN=

# --- manual override, used when no endpoint is set ---------------------------
# Plain integer count of active licensed devices.
RAIRIN_ACTIVE_DEVICES=
# Date shown beside the figure, e.g. 2026-09-06
RAIRIN_STATS_UPDATED_AT=

# With none of the above set, the site falls back to
# src/data/license-stats.json, refreshed by the GitHub Actions workflow.
# VPS credentials belong in GitHub Actions secrets, never here.
