# RaiRin-AI licence stats
#
# Copy to .env.local for local runs, or set the same keys in Vercel
# (Settings -> Environment Variables). Never commit real values.

# --- live figure, preferred --------------------------------------------------
# JSON endpoint returning { "active": <int> } (or { "unique": <int> }).
# Re-read every 5 minutes, so the hero tracks the server without a redeploy.
RAIRIN_STATS_URL=
# Bearer token for that endpoint, if it requires one.
RAIRIN_STATS_TOKEN=

# --- manual override, used when no endpoint is set ---------------------------
# Plain integer count of active licensed devices.
RAIRIN_ACTIVE_DEVICES=
# Date shown beside the figure, e.g. 2026-09-06
RAIRIN_STATS_UPDATED_AT=

# --- Midtrans direct QRIS ----------------------------------------------------
# Merchant ID and Client Key are identifiers; Server Key stays secret.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
# Server key from Midtrans dashboard. Never expose this as NEXT_PUBLIC_*.
MIDTRANS_SERVER_KEY=
# Use true with an SB-Mid-server-* key, false in production.
MIDTRANS_SANDBOX=true
# Random secret with at least 32 characters, e.g. `openssl rand -base64 48`.
PAYMENT_TOKEN_SECRET=
# Set Midtrans Payment Notification URL to:
# https://your-domain.example/api/payments/midtrans/webhook

# --- paid-license fulfillment -----------------------------------------------
# VPS account that owns reseller whitelist. Prefer an SSH key in production.
RAIRIN_VPS_HOST=
RAIRIN_VPS_PORT=22
RAIRIN_VPS_USER=
RAIRIN_VPS_PASSWORD=
RAIRIN_WHITELIST_PATH=/home/ubuntu/rairin/resellers/kaminari/whitelist.json
# Telegram bot notification destination. Keep bot token secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# With none of the above set, the site falls back to
# src/data/license-stats.json, refreshed by the GitHub Actions workflow.
# VPS credentials belong in GitHub Actions secrets, never here.
